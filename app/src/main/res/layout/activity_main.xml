<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- 상단 바: 파일 선택 및 상태 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnSelectFile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=".bdb 불러오기" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="파일을 불러와주세요"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 검색 영역 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="본문 단어 검색 (예: God, love, 사랑)"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnSearch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="검색" />
    </LinearLayout>

    <!-- 권 / 장 선택 드롭다운 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="#EEEEEE"
        android:orientation="horizontal"
        android:padding="4dp">

        <Spinner
            android:id="@+id/spinnerBook"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="2" />

        <Spinner
            android:id="@+id/spinnerChapter"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- 본문 읽기 영역 -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:background="#FAFAFA"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvBibleContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="6dp"
            android:text="상단의 [.bdb 불러오기] 버튼을 눌러 성경 파일을 선택하세요.\n한 번 불러오면 다음 실행 시 자동으로 열립니다."
            android:textColor="#222222"
            android:textIsSelectable="true"
            android:textSize="17sp" />
    </ScrollView>

    <!-- 하단 이전장 / 다음장 버튼 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnPrevChapter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="◀ 이전 장" />

        <Button
            android:id="@+id/btnNextChapter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="다음 장 ▶" />
    </LinearLayout>
</LinearLayout>
